# ---------------------------------------------------------------------------
# MedSync backend - RUNTIME environment variables.
#
# Copy this file to `.env` (excluded from git and from the Docker image),
# fill in real values, and pass it to the container at RUNTIME:
#     docker run --env-file .env ...
#     docker compose (service.env_file: .env)
#
# NEVER commit the real `.env` and NEVER bake these values into an image.
# ---------------------------------------------------------------------------

# --- Application ---
NODE_ENV=production
PORT=3000

# --- Database (Supabase / Postgres connection string) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Auth / JWT ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS (frontend origin allowed to call this API) ---
CORS_ORIGIN=http://localhost:5173

# --- Reverse proxy ---
# Set to `true` ONLY when the container runs behind a trusted reverse proxy
# (nginx / load balancer). Leave unset / false when exposing the port directly.
TRUST_PROXY=false
