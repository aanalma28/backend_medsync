// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  MASTERADMIN
  REGISTER_ADMIN
  DOCTOR
  PHARMACIST
  NURSE
  PATIENT
}

enum Category {
  DRUG            // Obat-obatan resep/bebas
  CONSUMABLE      // Alat habis pakai (infus, jarum, dll)
  SUPPLEMENT      // Obat-obatan tambahan (vitamin, dll)
  MEDICAL_DEVICE  // Alat medis (stetoskop, tensi, dll)
  OTHER           // Lainnya
}

model User {
  id                     String    @id @default(cuid())  
  name                   String?
  email                  String    @unique
  password               String
  role                   Role      @default(PATIENT)
  accepted_terms         Boolean   @default(false)
  remember_token         String?
  remember_token_expires DateTime?
  address                String
  phone                  String
  birth_date             DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
      
  patientUser         Patient?          @relation("PatientUser")
  employeeUser        Employee?         @relation("EmployeeUser")
  inventoryUser       InventoryLogs[]   @relation("UserWriter")
}

model Departmen {
  id             String @id @default(cuid())
  name           String
  departmen_code String
  address        String  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  employees Employee[]
}

model Patient {
  id                      String   @id @default(cuid())
  user                    User     @relation("PatientUser", fields: [user_id], references: [id])
  user_id                 String   @unique
  medical_record_number   String
  
  medicalHistories  MedicalHistory[] @relation("PatientMedicalHistory")
  patientRecipes    DoctorRecipe[]   @relation("PatientRecipes")
  patientAppoinments DoctorAppoinment[] @relation("PatientAppoinments")
}

model Employee {
  id              String    @id @default(cuid())
  user            User      @relation("EmployeeUser", fields: [user_id], references: [id])
  user_id         String    @unique
  staff_code      String
  departmen       Departmen @relation(fields: [departmen_id], references: [id])
  departmen_id    String

  medicalHistories  MedicalHistory[] @relation("DoctorMedicalHistory")
  doctorRecipes     DoctorRecipe[]   @relation("DoctorRecipes")
  pharmacistRecipes DoctorRecipe[]   @relation("PharmacistRecipes")
  doctorPractice    DoctorPractice[] @relation("DoctorPractice")
}

model Products {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    Category @default(DRUG)
  unit        String
  stock       Int
  min_stock   Int
  buy_price   Float
  sell_price  Float  
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi balik dari RecipeDetail
  recipeDetails RecipeDetail[]

  // Relasi ke InventoryLogs
  inventoryLogs InventoryLogs[] @relation("ProductInventoryLogs")
}

model InventoryLogs {
  id                 String   @id @default(cuid())
  product            Products @relation("ProductInventoryLogs", fields: [product_id], references: [id])
  product_id         String
  type               String
  quantity           Int
  buy_price          Float
  exp_date           DateTime?
  supplierName       String?  
  reference_number   String?
  user               User    @relation("UserWriter", fields: [user_id], references: [id])
  user_id            String
  notes              String?
  createdAt          DateTime @default(now())
}

model DoctorPractice {
  id            String   @id @default(cuid())
  doctor        Employee @relation("DoctorPractice", fields: [doctor_id], references: [id])
  doctor_id     String
  practice_date DateTime
  start_hour    String
  end_hour      String
  capacity      Int

  appoinments DoctorAppoinment[] @relation("DoctorPracticeAppoinments")
}

model DoctorAppoinment {
  id            String   @id @default(cuid())
  practice      DoctorPractice @relation("DoctorPracticeAppoinments", fields: [practice_id], references: [id])
  practice_id   String
  patient       Patient    @relation("PatientAppoinments", fields: [patient_id], references: [id])
  patient_id    String
  booking_date  DateTime
  status        String
  queue_number  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patientHistory MedicalHistory? @relation("PatientHistoryAppoinment")
}

model MedicalHistory {
  id              String   @id @default(cuid())
  patient         Patient  @relation("PatientMedicalHistory", fields: [patient_id], references: [id])
  patient_id      String
  appoinment      DoctorAppoinment @relation("PatientHistoryAppoinment", fields: [appoinment_id], references: [id])
  appoinment_id   String   @unique
  doctor          Employee @relation("DoctorMedicalHistory", fields: [doctor_id], references: [id])
  doctor_id       String
  complaint       String
  diagnosis       String
  notes           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  medicalRecipe   DoctorRecipe? @relation("MedicalRecipe")
}

model DoctorRecipe {
  id                    String   @id @default(cuid())
  medicalHistory        MedicalHistory @relation("MedicalRecipe", fields: [id_history], references: [id])
  id_history            String   @unique
  no_trx                String
  recipe_date_exec      DateTime
  patient               Patient     @relation("PatientRecipes", fields: [patient_id], references: [id])
  patient_id            String
  
  doctor                Employee     @relation("DoctorRecipes", fields: [doctor_id], references: [id])
  doctor_id             String
  
  pharmacist            Employee     @relation("PharmacistRecipes", fields: [pharmacist_id], references: [id])
  pharmacist_id         String
  
  status                String
  take_med_date         DateTime
  match_product_recipe Boolean
  verify_notes          String
  
  recipeDetails         RecipeDetail[]    
}

model RecipeDetail {
  id          String       @id @default(cuid())
  
  recipe      DoctorRecipe @relation(fields: [recipe_id], references: [id])
  recipe_id   String
  
  product    Products     @relation(fields: [product_id], references: [id])
  product_id String
  
  rules_using String
}