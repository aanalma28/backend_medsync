// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  SUPERADMIN
  MASTERADMIN
  REGISTER_ADMIN
  GENERAL_DOCTOR
  SPECIALIST_DOCTOR
  PHARMACIST
  NURSE
  PATIENT
}

enum Category {
  DRUG            // Obat-obatan resep/bebas
  CONSUMABLE      // Alat habis pakai (infus, jarum, dll)
  SUPPLEMENT      // Obat-obatan tambahan (vitamin, dll)
  MEDICAL_DEVICE  // Alat medis (stetoskop, tensi, dll)
  OTHER           // Lainnya
}

enum CategoryDepartmen{
  ADMIN
  GENERALIST
  SPECIALIST
  LABORATORY
  PHARMACY
  NURSING
}

enum SlotStatus{
  OPEN
  CLOSED  
}

enum RecipeStatus{
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AppoinmentStatus{
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED  
}

enum VisitStatus{
  REGISTERED
  NURSE_CHECKED
  DOCTOR_EXAMINED
  CANCELLED
  COMPLETED
}

enum Gender {
  LAKILAKI
  PEREMPUAN
}

enum Severity {
  MILD
  MODERATE
  SEVERE
}

model User {
  id                     String    @id @default(cuid())  
  name                   String?
  email                  String    @unique
  password               String
  role                   Role      @default(PATIENT)
  accepted_terms         Boolean   @default(false)
  remember_token         String?
  remember_token_expires DateTime?
  address                String
  phone                  String
  birth_date             DateTime
  is_active              Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
      
  patientUser         Patient[]          @relation("PatientUser")
  employeeUser        Employee?         @relation("EmployeeUser")
  inventoryUser       InventoryLogs[]   @relation("UserWriter")
  hospitals           Hospital[]        @relation("HospitalOwner")
}

model Hospital {
  id            String      @id @default(cuid())
  user          User?       @relation("HospitalOwner", fields: [user_id], references: [id], onDelete: SetNull)
  user_id       String?
  hospital_code String      @unique
  name          String
  address       String
  is_active     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  hospitalDepartments   Departmen[] @relation("HospitalDepartmens")
  hospitalInventoryLogs InventoryLogs[] @relation("HospitalInventoryLogs")
  hospitalPatientAllergy PatientAllergy[] @relation("HospitalPatientAllergy")
  hospitalProducts      Products[] @relation("HospitalProducts")
  hospitalStockBatch    StockBatch[] @relation("HospitalStockBatch")
  hospitalWarehouse       Warehouse[] @relation("HospitalWarehouse")
  hospitalWarehouseComponent WarehouseComponent[]  @relation("HospitalWarehouseComponent")
}

model Departmen {
  id             String    @id @default(cuid())
  hospital       Hospital  @relation("HospitalDepartmens", fields: [hospital_id], references: [id], onDelete: Restrict)
  hospital_id    String
  name           String
  departmen_code String
  category       CategoryDepartmen @default(GENERALIST)
  address        String?
  city           String?  
  is_active      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  employees Employee[]
}

model Patient {
  id                      String   @id @default(cuid())
  user                    User?    @relation("PatientUser", fields: [user_id], references: [id], onDelete: SetNull)
  user_id                 String?
  medical_record_number   String
  name                    String
  gender                  Gender   @default(LAKILAKI)
  age                     Int
  medicine_allergy        String?  
  is_active               Boolean  @default(true)
  deletedAt               DateTime?

  medicalHistories  Visit[] @relation("PatientVisitHistory")
  patientRecipes    DoctorRecipe[]   @relation("PatientRecipes")
  patientAppoinments DoctorAppoinment[] @relation("PatientAppoinments")
  patientAllergies  PatientAllergy[]  @relation("PatientAllergies")
}

model Employee {
  id              String    @id @default(cuid())
  user            User?     @relation("EmployeeUser", fields: [user_id], references: [id], onDelete: SetNull)
  user_id         String?   @unique
  staff_code      String
  gender          Gender    @default(LAKILAKI)
  departmen       Departmen @relation(fields: [departmen_id], references: [id], onDelete: Restrict)
  departmen_id    String

  nurseAssesments   NursingAssesment[] @relation("NursingRecord")
  doctorAssesments  DoctorAssesment[]  @relation("DoctorRecord")
  doctorRecipes     DoctorRecipe[]   @relation("DoctorRecipes")
  pharmacistRecipes DoctorRecipe[]   @relation("PharmacistRecipes")
  doctorPractice    DoctorPractice[] @relation("DoctorPractice")
  employeePatientAllergy PatientAllergy[] @relation("EmployeePatientAllergy")
}

// ==========================================
// 1. MASTER KATALOG PRODUK
// ==========================================
model Products {
  id          String   @id @default(cuid())
  hospital    Hospital @relation("HospitalProducts",fields: [hospital_id], references: [id], onDelete: Restrict)
  hospital_id String
  code        String   @unique
  name        String
  category    Category @default(DRUG)
  unit        String  
  buy_price   Float
  sell_price  Float  


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi balik dari RecipeDetail
  recipeDetails RecipeDetail[]

  // Relasi ke InventoryLogs
  inventoryLogs InventoryLogs[] @relation("ProductInventoryLogs")

  stocks      WarehouseStock[] @relation("ProductStocks")
  batches     StockBatch[] @relation("ProductBatches")  
}

// ==========================================
// 2. GUDANG UTAMA / PUSAT LOGISTIK
// ==========================================
model Warehouse {
  id            String               @id @default(cuid())
  hospital      Hospital             @relation("HospitalWarehouse", fields: [hospital_id], references: [id], onDelete: Restrict)
  hospital_id   String
  name          String               // Cth: "Gudang Utama Logistik Medis"
  description   String?
  
  components    WarehouseComponent[] @relation("WarehouseComponents")
  stocks        WarehouseStock[]     @relation("WarehouseStocks")
  batches       StockBatch[]         @relation("WarehouseBatches")
  logs          InventoryLogs[]      @relation("WarehouseInventoryLogs")
  
  createdAt     DateTime             @default(now())
}

// ==========================================
// 3. GUDANG KOMPONEN / DEPO UNIT SATELIT
// ==========================================
model WarehouseComponent {
  id            String               @id @default(cuid())
  hospital      Hospital             @relation("HospitalWarehouseComponent", fields: [hospital_id], references: [id], onDelete: Restrict)
  hospital_id   String
  warehouse     Warehouse            @relation("WarehouseComponents", fields: [warehouse_id], references: [id], onDelete: Cascade)
  warehouse_id  String  
  name          String               // Cth: "Depo Farmasi Resep", "Apotek Retail RS"
  type          String               // "PHARMACY_PRESCRIPTION", "PHARMACY_RETAIL", "POLI", "LAB", "IGD"
  
  stocks        WarehouseStock[] @relation("WarehouseComponentStocks")
  batches       StockBatch[]     @relation("WarehouseComponentBatches")
  logs          InventoryLogs[]  @relation("WarehouseComponentInventoryLogs")
  
  createdAt     DateTime             @default(now())
}

// ==========================================
// 4. STOK AKTUAL PER LOKASI
// ==========================================
model WarehouseStock {
  id                     String              @id @default(cuid())
  product                Products            @relation("ProductStocks", fields: [product_id], references: [id], onDelete: Restrict)
  product_id             String  
  
  warehouse              Warehouse?          @relation("WarehouseStocks", fields: [warehouse_id], references: [id], onDelete: Cascade)
  warehouse_id           String?  
  
  warehouseComponent     WarehouseComponent? @relation("WarehouseComponentStocks", fields: [warehouse_component_id], references: [id], onDelete: Cascade)
  warehouse_component_id String?
  
  stock                  Int                 @default(0)
  min_stock              Int                 @default(5)
  
  @@unique([product_id, warehouse_id])
  @@unique([product_id, warehouse_component_id])
}

// ==========================================
// 5. BATCH & KEDALUWARSA (FEFO SUPPORT)
// ==========================================
model StockBatch {
  id                     String              @id @default(cuid())
  hospital               Hospital            @relation("HospitalStockBatch", fields: [hospital_id], references: [id], onDelete: Restrict)
  hospital_id            String
  product                Products            @relation("ProductBatches", fields: [product_id], references: [id], onDelete: Cascade)
  product_id             String
  
  warehouse              Warehouse?          @relation("WarehouseBatches", fields: [warehouse_id], references: [id], onDelete: Cascade)
  warehouse_id           String?
  
  warehouseComponent     WarehouseComponent? @relation("WarehouseComponentBatches", fields: [warehouse_component_id], references: [id], onDelete: Cascade)
  warehouse_component_id String?
  
  batch_number           String              // Nomor batch pabrik dari faktur
  exp_date               DateTime            // Tanggal kedaluwarsa obat
  initial_stock          Int                 // Jumlah awal batch masuk
  current_stock          Int                 // Sisa kuantiti aktual batch ini
  
  createdAt              DateTime            @default(now())
}

// ==========================================
// 6. BUKU BESAR AUDIT MUTASI (INVENTORY LOGS)
// ==========================================
model InventoryLogs {
  id                     String              @id @default(cuid())
  hospital               Hospital            @relation("HospitalInventoryLogs", fields: [hospital_id], references: [id], onDelete: Restrict)
  hospital_id            String
  product                Products            @relation("ProductInventoryLogs", fields: [product_id], references: [id])
  product_id             String
  
  warehouse              Warehouse?          @relation("WarehouseInventoryLogs", fields: [warehouse_id], references: [id])
  warehouse_id           String?
  
  warehouseComponent     WarehouseComponent? @relation("WarehouseComponentInventoryLogs", fields: [warehouse_component_id], references: [id])
  warehouse_component_id String?

  user                   User?               @relation("UserWriter", fields: [user_id], references: [id])
  user_id                String?
  
  type                   String              // PURCHASE, TRANSFER_OUT, TRANSFER_IN, USAGE, DISPENSE, RETURN
  quantity               Int                 // Nilai mutasi (+ masuk, - keluar)
  source_destination     String?             // Keterangan pihak luar (Cth: "PT. Kimia Farma")
  reference_number       String?             // No PO, No Faktur, No Amprahan, No Resep  
  notes                  String?
  
  createdAt              DateTime            @default(now())
}

// ==========================================
// 7. STRUKTUR KLINIS: ALERGI PASIEN
// ==========================================
model PatientAllergy {
  id          String   @id @default(cuid())
  hospital    Hospital @relation("HospitalPatientAllergy", fields: [hospital_id], references: [id], onDelete: Restrict)
  hospital_id String
  patient     Patient  @relation("PatientAllergies", fields: [patient_id], references: [id], onDelete: Cascade)
  patient_id  String   // Relasi ke User / Pasien
  employee    Employee @relation("EmployeePatientAllergy", fields: [employee_id], references: [id], onDelete: SetNull)
  employee_id String
  
  allergen    String   // Nama obat / golongan pemicu (Cth: Penisilin)
  severity    Severity @default(MILD)   // MILD (Ringan), MODERATE (Sedang), SEVERE (Berat)
  reaction    String?  // Deskripsi reaksi (Cth: Ruam & sesak napas)  
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DoctorPractice {
  id            String   @id @default(cuid())
  doctor        Employee? @relation("DoctorPractice", fields: [doctor_id], references: [id], onDelete: SetNull)
  doctor_id     String?
  practice_date DateTime    

  slotsPractice SlotPractice[] @relation("DoctorPracticeSlots")  
}

model SlotPractice {
  id            String   @id @default(cuid())
  practice      DoctorPractice @relation("DoctorPracticeSlots", fields: [practice_id], references: [id], onDelete: Cascade)
  practice_id   String
  name          String 
  start_hour    String
  end_hour      String
  status_slot   SlotStatus @default(OPEN)
  is_active     Boolean @default(true)
  max_patient   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appoinments   DoctorAppoinment[] @relation("DoctorPracticeSlots")
}

model DoctorAppoinment {
  id                        String   @id @default(cuid())
  slotPractice              SlotPractice @relation("DoctorPracticeSlots", fields: [slot_practice_id], references: [id], onDelete: Restrict)
  slot_practice_id          String
  patient                   Patient    @relation("PatientAppoinments", fields: [patient_id], references: [id], onDelete: Restrict)
  patient_id                String    
  status                    AppoinmentStatus @default(PENDING)
  queue_number              Int
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  patientHistory Visit? @relation("PatientHistoryAppoinment")
}

model Visit {
  id              String   @id @default(cuid())
  patient         Patient  @relation("PatientVisitHistory", fields: [patient_id], references: [id], onDelete: Restrict)
  patient_id      String
  appoinment      DoctorAppoinment @relation("PatientHistoryAppoinment", fields: [appoinment_id], references: [id], onDelete: Cascade)
  appoinment_id   String   @unique
  status          VisitStatus @default(REGISTERED)
  payerType       String   @default("Umum")
  complaint       String?
  detail_sympton  String?    
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  nursingRecord   NursingAssesment? @relation("NursingRecord")
  doctorRecord    DoctorAssesment? @relation("DoctorRecord")
  medicalRecipe   DoctorRecipe? @relation("VisitRecipe")
}

model NursingAssesment {
  id              String   @id @default(cuid())
  visit           Visit    @relation("NursingRecord", fields: [visit_id], references: [id], onDelete: Cascade)
  visit_id        String   @unique
  nurse_id        String?
  nurse           Employee? @relation("NursingRecord", fields: [nurse_id], references: [id], onDelete: SetNull)
  sistolic        Int?
  diastolic       Int?
  heart_rate      Int?
  respiratory_rate Int?
  temperature     Float?
  weight          Float?
  height          Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DoctorAssesment {
  id              String   @id @default(cuid())
  visit           Visit    @relation("DoctorRecord", fields: [visit_id], references: [id], onDelete: Cascade)
  visit_id        String   @unique
  doctor_id       String?
  doctor          Employee? @relation("DoctorRecord", fields: [doctor_id], references: [id], onDelete: SetNull)
  subjective      String?  // S - Keluhan tambahan dari sudut pandang dokter
  objective       String?  // O - Hasil pemeriksaan fisik dokter
  assessment      String?  // A - Diagnosis kerja / Kode ICD-10
  plan            String?  // P - Rencana pengobatan / tindakan medis
  doctorNotes     String?  // Catatan bebas tambahan dari dokter
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DoctorRecipe {
  id                    String   @id @default(cuid())
  visit_id              String   @unique
  visit                 Visit    @relation("VisitRecipe", fields: [visit_id], references: [id], onDelete: Cascade)
  no_trx                String
  recipe_date_exec      DateTime
  patient               Patient?     @relation("PatientRecipes", fields: [patient_id], references: [id], onDelete: Restrict)
  patient_id            String?
  
  doctor                Employee?     @relation("DoctorRecipes", fields: [doctor_id], references: [id], onDelete: SetNull)
  doctor_id             String?
  
  pharmacist            Employee?    @relation("PharmacistRecipes", fields: [pharmacist_id], references: [id], onDelete: SetNull)
  pharmacist_id         String?
  
  status                RecipeStatus       @default(PENDING)
  take_med_date         DateTime?
  match_product_recipe Boolean?     @default(true)
  verify_notes          String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  recipeDetails         RecipeDetail[]    
}

model RecipeDetail {
  id          String       @id @default(cuid())
  
  recipe      DoctorRecipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  recipe_id   String
  
  product    Products     @relation(fields: [product_id], references: [id], onDelete: Restrict)
  product_id String
  
  qty           Int      // Jumlah fisik obat diberikan
  dosage        String   // Aturan pakai (Cth: 3x1 sesudah makan)
  duration_days Int      // Lama konsumsi dalam hari (Cth: 10 hari)
  start_date    DateTime // Tanggal mulai resep
  end_date      DateTime // Tanggal otomatis habis (start_date + duration_days)
  
  createdAt     DateTime @default(now())
}